# trading-intel — environment template
# Copy this file to `.env` and fill in real values
# NEVER commit `.env` — it's gitignored

# ─── ConvexValue (PRIMARY data source) ──────────────────────────────
# Pro tier. Create account at convexvalue.com
CONVEX_EMAIL=
CONVEX_PASSWORD=
CONVEX_ACCOUNT_TYPE=pro

# ─── Anthropic (Claude API for AM summary + tagging) ────────────────
# Create at console.anthropic.com
ANTHROPIC_API_KEY=
# Model selection (defaults sensible; override only if needed)
CLAUDE_DAILY_MODEL=claude-sonnet-4-6
CLAUDE_WEEKLY_MODEL=claude-opus-4-6

# ─── Voyage AI (embeddings for pgvector) ────────────────────────────
# Create at voyageai.com
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# ─── FRED (macro data) ──────────────────────────────────────────────
# Free, create at fredaccount.stlouisfed.org
FRED_API_KEY=

# ─── Discord (alerts) ───────────────────────────────────────────────
# Server settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=

# ─── Database ───────────────────────────────────────────────────────
# Local dev (docker-compose):
DATABASE_URL=postgresql+psycopg://intel:intel@localhost:5432/trading_intel
# Production (DO managed Postgres) — replace on droplet:
# DATABASE_URL=postgresql+psycopg://intel:PASS@HOST:25060/trading_intel?sslmode=require

# ─── App config ─────────────────────────────────────────────────────
APP_ENV=development                # development | production
LOG_LEVEL=INFO
WATCHLIST=SPY,QQQ,SPX,AAPL,MSFT,GOOGL,AMZN,META,NVDA,TSLA,AMD,SMCI,PLTR
TZ=America/New_York

# ─── Schwab (PARKED — not in daily path) ────────────────────────────
# Kept for future account/portfolio integration. Safe to leave blank.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1
SCHWAB_TOKEN_PATH=data/token.json

# ─── Optional future vendors ────────────────────────────────────────
BARCHART_API_KEY=
TRADIER_TOKEN=
