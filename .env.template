# trading-intel — environment template
# Copy this file to `.env` and fill in real values
# NEVER commit `.env` — it's gitignored

# ─── ConvexValue (PRIMARY data source) ──────────────────────────────
CONVEX_EMAIL=
CONVEX_PASSWORD=
CONVEX_ACCOUNT_TYPE=pro

# ─── Local LLM via Ollama (free — replaces paid Anthropic/Voyage) ───
# Install from https://ollama.com — see docs/learning/local-llm-setup.md
OLLAMA_HOST=http://localhost:11434
LLM_DAILY_MODEL=qwen2.5:14b
LLM_WEEKLY_MODEL=qwen2.5:32b
LLM_TAGGING_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ─── FRED (free macro data) ─────────────────────────────────────────
FRED_API_KEY=

# ─── Discord webhooks ───────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
DISCORD_FLOW_WEBHOOK_URL=
DISCORD_IV_WEBHOOK_URL=
DISCORD_VEX_WEBHOOK_URL=
DISCORD_SIGNALS_WEBHOOK_URL=
DISCORD_INTERNALS_WEBHOOK_URL=
DISCORD_TRENDS_WEBHOOK_URL=
FLOW_ALERT_THRESHOLD=10

# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://intel:intel@localhost:5432/trading_intel

# ─── App config ─────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
WATCHLIST=SPY,QQQ,SPX,AAPL,MSFT,GOOGL,AMZN,META,NVDA,TSLA,AMD,SMCI,PLTR
TZ=America/New_York

# ─── Schwab (PARKED — not in daily path) ────────────────────────────
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1
SCHWAB_TOKEN_PATH=data/token.json
