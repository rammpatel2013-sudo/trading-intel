# trading-intel — environment template
# Copy this file to `.env` and fill in real values
# NEVER commit `.env` — it's gitignored

# ─── ConvexValue (PRIMARY data source) ──────────────────────────────
CONVEX_EMAIL=
CONVEX_PASSWORD=
CONVEX_ACCOUNT_TYPE=pro

# ─── Local LLM via Ollama (free — replaces paid Anthropic/Voyage) ───
# Install from https://ollama.com — see docs/learning/local-llm-setup.md
OLLAMA_HOST=http://localhost:11434
LLM_DAILY_MODEL=qwen2.5:14b
LLM_WEEKLY_MODEL=qwen2.5:32b
LLM_TAGGING_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# ─── FRED (free macro data) ─────────────────────────────────────────
FRED_API_KEY=

# ─── Discord webhooks ───────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
DISCORD_FLOW_WEBHOOK_URL=
DISCORD_IV_WEBHOOK_URL=
DISCORD_VEX_WEBHOOK_URL=
DISCORD_SIGNALS_WEBHOOK_URL=
DISCORD_INTERNALS_WEBHOOK_URL=
DISCORD_TRENDS_WEBHOOK_URL=
FLOW_ALERT_THRESHOLD=10

# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://intel:intel@localhost:5432/trading_intel

# ─── App config ─────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
WATCHLIST=SPY,QQQ,SPX,AAPL,MSFT,GOOGL,AMZN,META,NVDA,TSLA,AMD,SMCI,PLTR
TZ=America/New_York

# ─── Intraday 0DTE/1DTE volume flow (5-min collector) ───────────────
# Focused symbol set for the high-frequency 0DTE/1DTE volume-weighted pull.
INTRADAY_SYMBOLS=SPX,SPY,QQQ
# +/- fraction of spot for the tight intraday strike window (0.03 = +/-3%).
INTRADAY_STRIKE_RANGE=0.03
# Max calendar days-to-expiry to keep (1 = 0DTE + 1DTE).
INTRADAY_MAX_DTE=1
# Auto-delete per-strike 5-min intraday_flow rows older than this many hours.
INTRADAY_RETENTION_HOURS=48

# ─── Daily price history (quotes_daily) ─────────────────────────────
# One-time backfill depth and the daily refresh pull window (yfinance periods).
QUOTES_BACKFILL_PERIOD=5y
QUOTES_REFRESH_PERIOD=6mo

# ─── Daily chain snapshot breadth (GEX-surface all-expiry views) ────
# How many expirations + how wide a strike band the daily chain_snapshot pulls.
# Wider = a true all-expiry GEX surface but heavier Convex load; lower these to
# scope down (e.g. MAX_EXPS=12, STRIKE_RANGE=0.15).
CHAIN_SNAPSHOT_MAX_EXPS=40
CHAIN_SNAPSHOT_STRIKE_RANGE=0.30

# ─── Options flow snapshots ─────────────────────────────────────────
FLOW_TOP_N=10
FLOW_MIN_PACKAGE_PREMIUM=250000

# ─── Options time & sales capture (Phase 3 NAS tape -> tas_prints) ──
# All optional — these are the defaults; uncomment in .env to override.
# TAS_MIN_PREMIUM=25000        # keep prints with notional (price*size*100) >= this $
# TAS_LIMIT=2000               # raw prints pulled per poll (indices flood the tape; pull wide)
# TAS_EXCLUDE_ROOTS=SPY,QQQ,SPX,SPXW  # high-volume index roots (covered by other jobs; add IWM,VIX,NDX,RUT to taste)
# TAS_POLL_INTERVAL=30         # seconds between polls (NAS capture daemon)
# TAS_RETENTION_DAYS=30        # prune raw tas_prints older than this many days

# ─── Schwab (PARKED — not in daily path) ────────────────────────────
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1
SCHWAB_TOKEN_PATH=data/token.json
